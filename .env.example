# -----------------------------------------------------------------------------
# Vercel Blob Storage (24-Hour MP3 Cache)
# Create a Blob store in Vercel Dashboard -> Storage -> Blob to auto-inject this.
# Leave empty locally to use the built-in .data/cache/ local disk fallback.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# Vercel Cron Security
# Set a random string in Vercel env vars; Vercel automatically sends
# `Authorization: Bearer <CRON_SECRET>` when invoking /api/cron/cleanup.
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Cache Settings
# Default TTL in hours (defaults to 24) and max audio duration in seconds (3600 = 1h)
# -----------------------------------------------------------------------------
CACHE_TTL_HOURS="24"
MAX_DURATION_SECONDS="3600"

# -----------------------------------------------------------------------------
# Optional: YouTube Anti-Bot Bypass for Datacenter / Vercel IPs
# If YouTube blocks Vercel AWS IPs with "Sign in to confirm you're not a bot":
# 1) YOUTUBE_PROXY: HTTP/HTTPS residential/rotating proxy URL (e.g. http://user:pass@host:port)
# 2) YOUTUBE_COOKIES: JSON array of cookies exported from browser (EditThisCookie format)
#    or raw Cookie header string (e.g. "VISITOR_INFO1_LIVE=...; SID=...; __Secure-3PSID=...")
# -----------------------------------------------------------------------------
YOUTUBE_PROXY=""
YOUTUBE_COOKIES=""

# -----------------------------------------------------------------------------
# Optional: SoundCloud Client ID Override
# Auto-discovered automatically from SoundCloud web bundles if left blank.
# -----------------------------------------------------------------------------
SOUNDCLOUD_CLIENT_ID=""
